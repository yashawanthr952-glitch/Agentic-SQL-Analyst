# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-...

DATABASE_URL=postgresql+psycopg://analyst_ro:analyst_ro@localhost:5432/analytics

# Guardrails
MAX_ROWS=1000
STATEMENT_TIMEOUT_MS=5000

# Agent
MODEL=claude-opus-5
MAX_RETRIES=3
# Adaptive thinking on the plan/generate nodes. Set false if you want the
# cheapest possible calls.
USE_ADAPTIVE_THINKING=true

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
